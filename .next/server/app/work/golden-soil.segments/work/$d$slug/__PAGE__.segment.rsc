0:{"rsc":["$","$1","c",{"children":[[["$","$L2",null,{"project":{"slug":"golden-soil","title":"Golden Soil","category":null,"thumbnail":"/images/work/golden-soil/thumb.jpg","summary":"Golden Soil products are inspired by the Bajan family tradition of believing that natural beauty must not be compromised with harmful ingredients. They combined rich minerals with the finest blends of natural plant and fruit extracts, formulated on the Island of Barbados.","images":["/images/work/golden-soil/img-1.jpg"],"videoUrl":null,"blocks":[{"type":"text-row","heading":"Approach","reverse":true,"text":"The colors, textures, history, and lifestyle of this island provided all we needed to set the perfect tone. Our goal was to capture both the relaxed lifestyle and the vibrance of the setting."},{"type":"full-image","image":"/images/work/golden-soil/img-2.jpg","imageWidth":1600,"imageHeight":1176,"alt":"Golden Soil brand assets"},{"type":"text-row","heading":"UI Design","text":"The strength of the black and gold foundational palette gave us numerous options for enhancing the vibrant colors of the product’s ingredients. The screen layout, transitions, and interface animations all adhere to this aesthetic."},{"type":"image-pair","images":["/images/work/golden-soil/img-3.jpg","/images/work/golden-soil/img-4.jpg"]},{"type":"text-row","heading":"Video Production","reverse":true,"text":"Capturing the essence of Barbados is to capture the essence of the people. The ebony tones of the island’s women showcase the results that can be achieved with golden soil products. This contrasted with the exotic landscapes of the island, completes the scene."}]}}],["$","$L3",null,{"project":"$0:rsc:props:children:0:0:props:project"}]],[["$","script","script-0",{"src":"/_next/static/chunks/1y7u-8e-s3dda.js","async":true}]],["$","$L4",null,{"children":["$","$5",null,{"name":"Next.MetadataOutlet","children":"$@6"}]}]]}],"isPartial":false,"staleTime":300,"varyParams":null,"buildId":"shx2I4moPTxSoIrjMx8j6"}
