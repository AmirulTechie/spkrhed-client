0:{"rsc":["$","$1","c",{"children":[[["$","$L2",null,{"project":{"slug":"panasas","title":"Panasas","category":null,"thumbnail":"/images/work/panasas/thumb.jpg","summary":"Panasas provides purpose-built storage for high-performance applications in manufacturing, life sciences, energy, media, financial services, and government.","images":["/images/work/panasas/img-1.jpg"],"videoUrl":null,"blocks":[{"type":"text-row","heading":"Approach","reverse":true,"text":"This is a simple tech product with a host of complex applications. Streamlining the message was the essential ingredient for this project."},{"type":"video-embed","variant":"ambient","src":"https://player.vimeo.com/video/720928433?api=1&background=1&autoplay=1&loop=1&title=0&byline=0&portrait=0"},{"type":"text-row","heading":"3D + Animation + Virtual Reality","text":"The Speakerhead team wanted to create a memorable presentation to give potential buyers the “Wow” experience. We decided to go into the VR space and invite users to experience the products firsthand. Exhibitors were able to walk into Panasas’ virtual server room. In addition, users were also able to open doors, pull out the racks, and manipulate them in full 360 degrees movements."},{"type":"image-gallery","images":["/images/work/panasas/img-4.jpg","/images/work/panasas/img-5.jpg","/images/work/panasas/img-6.jpg","/images/work/panasas/img-2.jpg","/images/work/panasas/img-3.jpg"]},{"type":"full-image","image":"/images/work/panasas/img-2.jpg","imageWidth":2000,"imageHeight":1333,"alt":"Panasas virtual server room"}]}}],["$","$L3",null,{"project":"$0:rsc:props:children:0:0:props:project"}]],[["$","script","script-0",{"src":"/_next/static/chunks/1y7u-8e-s3dda.js","async":true}]],["$","$L4",null,{"children":["$","$5",null,{"name":"Next.MetadataOutlet","children":"$@6"}]}]]}],"isPartial":false,"staleTime":300,"varyParams":null,"buildId":"ttCSypC88TdHJeMqW-YhR"}
