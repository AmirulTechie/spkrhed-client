0:{"rsc":["$","$1","c",{"children":[[["$","$L2",null,{"project":{"slug":"hairdreams","title":"HairDreams","category":null,"thumbnail":"/images/work/hairdreams/thumb.jpg","summary":"Hairdreams is an international luxury brand in professional hair extensions and lengthening and thickening systems. They offer hair extensions, thickening, and hair loss solutions of unparalleled quality.","images":["/images/work/hairdreams/img-1.jpg"],"videoUrl":null,"blocks":[{"type":"text-row","heading":"Approach","reverse":true,"text":"In the world of sophisticated hair creations, Hairdreams has few rivals. Our approach was to develop a comprehensive brand identity that effectively illustrated their contributions to the evolution of the hair extension industry."},{"type":"video-embed","variant":"player","src":"https://www.youtube.com/embed/B_Nnv8QdeoA?title=0&byline=0&portrait=0"},{"type":"text-row","heading":"Video Production","text":"Our Hairdreams video project, Hollywood Icons, used stars from across Hollywood’s glamorous history to illustrate the diversity of styles and the innovative approach that have made Hairdreams a leader in their field. Using the point of view of a young girl as our centerpiece allowed us to develop an aspirational perspective in our viewers as we transported them across time."}]}}],["$","$L3",null,{"project":"$0:rsc:props:children:0:0:props:project"}]],[["$","script","script-0",{"src":"/_next/static/chunks/1y7u-8e-s3dda.js","async":true}]],["$","$L4",null,{"children":["$","$5",null,{"name":"Next.MetadataOutlet","children":"$@6"}]}]]}],"isPartial":false,"staleTime":300,"varyParams":null,"buildId":"shx2I4moPTxSoIrjMx8j6"}
