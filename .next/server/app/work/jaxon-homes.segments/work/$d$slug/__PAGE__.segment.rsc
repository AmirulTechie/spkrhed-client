0:{"rsc":["$","$1","c",{"children":[[["$","$L2",null,{"project":{"slug":"jaxon-homes","title":"Jaxon Homes","category":null,"thumbnail":"/images/work/jaxon-homes/thumb.jpg","summary":"Jaxon Home was founded in 2006 by Victoria Richter, an industry veteran with over 15 years of experience. Jaxon Home specializes in unique upholstery and leather furniture made in Los Angeles, California. Jaxon Home approached Speakerhead to do a studio rebranding launch. Rather than invest in staging, lighting, and photography, they reached out to Speakerhead to develop the launch online.","images":["/images/work/jaxon-homes/img-1.jpg"],"videoUrl":null,"blocks":[{"type":"text-row","heading":"Approach","reverse":true,"text":"Jaxon Home approached Speakerhead to do a studio rebranding launch. Instead of spending a small fortune on staging, lighting, and photography, they reached out to Speakerhead to develop the 3D animations."},{"type":"full-image","image":"/images/work/jaxon-homes/img-2.jpg","imageWidth":2000,"imageHeight":1391,"alt":"Jaxon Homes digital OOH display"},{"type":"text-row","heading":"3D Modeling","text":"Speakerhead’s interior visualizations gave us the opportunity to develop a comprehensive series of designs that presented a consistent aesthetic."},{"type":"image-grid","images":["/images/work/jaxon-homes/img-3.jpg","/images/work/jaxon-homes/img-4.jpg","/images/work/jaxon-homes/img-5.jpg","/images/work/jaxon-homes/img-6.jpg","/images/work/jaxon-homes/img-7.jpg","/images/work/jaxon-homes/img-8.jpg","/images/work/jaxon-homes/img-9.jpg","/images/work/jaxon-homes/img-10.jpg"]},{"type":"text-row","heading":"OOH Campaign","reverse":true,"text":"The additional brand assets for the Jaxon Home campaign bolstered the modern appeal represented in the interior design."},{"type":"full-image","image":"/images/work/jaxon-homes/img-11.jpg","imageWidth":2000,"imageHeight":1335,"alt":"Jaxon Homes building wraparound billboard"}]}}],["$","$L3",null,{"project":"$0:rsc:props:children:0:0:pro