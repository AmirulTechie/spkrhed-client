0:{"rsc":["$","$1","c",{"children":[[["$","$L2",null,{"project":{"slug":"tzuri","title":"TZURI","category":null,"thumbnail":"/images/work/tzuri/thumb.jpg","summary":"Zuri Mesica is a distinguished name in the wholesale jewelry business. His signature styles are covered by celebrities and international clients with distinguished tastes.","images":["/images/work/tzuri/img-1.jpg"],"videoUrl":null,"blocks":[{"type":"text-row","heading":"Approach","reverse":true,"text":"Simplicity and elegance are the signatures of Zuri’s work. Our mission was to maintain that simplicity in a controlled atmosphere of elegance."},{"type":"video-embed","variant":"ambient","src":"https://player.vimeo.com/video/720926816?api=1&background=1&autoplay=1&loop=1&title=0&byline=0&portrait=0"},{"type":"text-row","heading":"Production + 3D + Animation","text":"Using Zuri’s award award-winning design, we bridged the gap between reality and fantasy. We accomplished this by bringing one of his classic 18k gold, VVS + diamond-encrusted masterpieces to life. The concept was an homage to the classic Disney film, Fantasia."}]}}],["$","$L3",null,{"project":"$0:rsc:props:children:0:0:props:project"}]],[["$","script","script-0",{"src":"/_next/static/chunks/1y7u-8e-s3dda.js","async":true}]],["$","$L4",null,{"children":["$","$5",null,{"name":"Next.MetadataOutlet","children":"$@6"}]}]]}],"isPartial":false,"staleTime":300,"varyParams":null,"buildId":"EuUkEz2n-gpKNLGZPLCbR"}
