0:{"rsc":["$","$1","c",{"children":[[["$","$L2",null,{"project":{"slug":"spliff-stick","title":"Spliff Stick","category":null,"thumbnail":"/images/work/spliff-stick/thumb.jpg","summary":"Spliff Stick is an innovative line of vapes and cartridges that are reliable and efficient. They required a design that would exemplify their style and function.","images":["/images/work/spliff-stick/img-1.jpg"],"videoUrl":null,"blocks":[{"type":"text-row","heading":"Approach","reverse":true,"text":"Speakerhead was tasked with developing 3D models of the device that could be used in the development of a prototype."},{"type":"video-embed","variant":"ambient","src":"https://player.vimeo.com/video/720926546?api=1&background=1&autoplay=1&loop=1&title=0&byline=0&portrait=0"},{"type":"text-row","heading":"Product Design","text":"Our concept relied on streamlining the look of a vape pen that could accommodate both tobacco and cannabis oils. We modeled the pen with the intention of the device maintaining the presence of a piece of futuristic art, as opposed to the often-clunky function over form devices available in the current market."},{"type":"image-gallery","images":["/images/work/spliff-stick/img-2.jpg","/images/work/spliff-stick/img-3.jpg","/images/work/spliff-stick/img-4.jpg","/images/work/spliff-stick/img-5.jpg","/images/work/spliff-stick/img-6.jpg","/images/work/spliff-stick/img-7.jpg","/images/work/spliff-stick/img-8.jpg","/images/work/spliff-stick/img-9.jpg"]},{"type":"text-row","heading":"Video Production","reverse":true,"text":"Spliff Stick represents style, sophistication, and unique functionality in the vape device industry. The video Speakerhead produced exemplified those qualities by synthesizing elegant 3D animation and an exotic musical score."}]}}],["$","$L3",null,{"project":"$0:rsc:props:children:0:0:props:project"}]],[["$","script","script-0",{"src":"/_next/static/chunks/1y7u-8e-s3dda.js","async":true}]],["$","$L4",null,{"children":["$","$5",null,{"name":"Next.Metadata