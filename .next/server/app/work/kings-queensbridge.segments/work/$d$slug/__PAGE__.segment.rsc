0:{"rsc":["$","$1","c",{"children":[[["$","$L2",null,{"project":{"slug":"kings-queensbridge","title":"Kings of Queensbridge","category":null,"thumbnail":"/images/work/kings-queensbridge/thumb.jpg","summary":"This documentary takes place during the treacherous drug wars of the 80's and 90’s inside one of the most crime-ridden housing complexes in the country…the Queensbridge housing project. This is a rare behind-the-scenes look into the lives of a group of young black males and their quest for power on the mean streets of Queensbridge.","images":["/images/work/kings-queensbridge/img-1.jpg"],"videoUrl":null,"blocks":[{"type":"text-row","heading":"Approach","reverse":true,"text":"Action was the essential component in all of the layout’s design and animation of this urban documentary. Creating brand assets that reflected that ideal was our mission."},{"type":"full-image","image":"/images/work/kings-queensbridge/img-2.jpg","imageWidth":2000,"imageHeight":1333,"alt":"Kings of Queensbridge key art"},{"type":"text-row","heading":"Animation","text":"The producers had storyboards that depicted street soldiers in the heat of the battle. We used animation to illustrate the human toll exacted by this secret war."},{"type":"image-gallery","images":["/images/work/kings-queensbridge/img-3.png","/images/work/kings-queensbridge/img-4.png","/images/work/kings-queensbridge/img-5.png","/images/work/kings-queensbridge/img-6.png","/images/work/kings-queensbridge/img-7.png","/images/work/kings-queensbridge/img-8.png","/images/work/kings-queensbridge/img-9.png","/images/work/kings-queensbridge/img-10.png","/images/work/kings-queensbridge/img-11.png","/images/work/kings-queensbridge/img-12.png","/images/work/kings-queensbridge/img-13.png","/images/work/kings-queensbridge/img-14.png","/images/work/kings-queensbridge/img-15.png","/images/work/kings-queensbridge/img-16.png","/images/work/kings-queensbridge/img-17.png","/images/work/kings-queensbridge/img-18.png","/images/work/kings-queensbridge/img-19.png","/images/work/kings-queensbridge/img-20.png","/images/work/kings-queensbridge/img-21.jpg","/images/work/kings-queensbridge/img-22.jpg","/images/work/kings-queensbridge/img-23.png","/images/work/kings-queensbridge/img-24.png"]},{"type":"video-embed","variant":"ambient","src":"https://player.vimeo.com/video/720930368?api=1&background=1&autoplay=1&loop=1&title=0&byline=0&portrait=0"},{"type":"text-row","heading":"Branding","reverse":true,"text":"We wanted to capture this gritty, underground lifestyle and let it speak for itself. The narrative is open-ended to leave room for the audience's interpretation of the material."}]}}],["$","$L3",null,{"project":"$0:rsc:props:children:0:0:props:project"}]],[["$","script","script-0",{"src":"/_next/static/chunks/1y7u-8e-s3dda.js","async":true}]],["$","$L4",null,{"children":["$","$5",null,{"name":"Next.MetadataOutlet","children":"$@6"}]}]]}],"isPartial":false,"staleTime":300,"varyParams":null,"buildId":"shx2I4moPTxSoIrjMx8j6"}
