0:{"rsc":["$","$1","c",{"children":[[["$","$L2",null,{"project":{"slug":"flowtrainer","title":"FlowTrainer","category":null,"thumbnail":"/images/work/flowtrainer/thumb.jpg","summary":"Flowlab is dedicated to the development of immersive educational content and simulation networks in the Metaverse. Flowlab works with psychiatrists, psychologists, media specialists, educators, government agencies, and the private sector to pursue advancements in the wellness and human performance industries.","images":["/images/work/flowtrainer/img-1.jpg"],"videoUrl":null,"blocks":[{"heading":"Approach","text":"Our intention with Flowlab, Inc. was to create a progressive brand that accurately represented the level of innovation evident in its products and services.","image":"/images/work/flowtrainer/img-2.jpg","imageWidth":1000,"imageHeight":1000,"imageSide":"right"},{"type":"full-image","image":"/images/work/flowtrainer/img-3.jpg","imageWidth":2000,"imageHeight":1325,"alt":"FlowTrainer trade show booth"},{"type":"text-row","heading":"Branding","text":"Flowlab’s branding had to appeal to a wide spectrum of clients in the government and private sectors. Speakerhead designed and deployed branding with a futuristic aesthetic. The powerful contrasts in the design connote power, authority, and sustainability."},{"type":"full-image","image":"/images/work/flowtrainer/img-4.jpg","imageWidth":1600,"imageHeight":1010,"alt":"FlowTrainer investor deck"},{"type":"text-row","heading":"Virtual Reality","reverse":true,"text":"The Flow Trainer System is the flagship project of Flowlab. The promotional video Speakerhead created was far superior to the usual PowerPoint or industrial videos often presented in government circles. The cinematic qualities of our presentation caught the attention of the Johns Hopkins Applied Physics Lab, Lockheed Martin, and the US Navy.\n\nFlowlabs EMVR simulator project presented another challenge: persuading average consumers to be early adopters of VR technologies for wellness. The promotional video we created accurately describes the origin of the technology while incorporating the idea of ease of use in a comfortable and familiar setting."}]}}],["$","$L3",null,{"project":"$0:rsc:props:children:0:0:props:project"}]],[["$","script","script-0",{"src":"/_next/static/chunks/1y7u-8e-s3dda.js","async":true}]],["$","$L4",null,{"children":["$","$5",null,{"name":"Next.MetadataOutlet","children":"$@6"}]}]]}],"isPartial":false,"staleTime":300,"varyParams":null,"buildId":"j631GEQZ6xMiDdeNEAWz8"}
