a:[["$","$L15",null,{"project":{"slug":"yeppers-gaming","title":"Yeppers Gaming","category":null,"thumbnail":"/images/work/yeppers-gaming/thumb.jpg","summary":"Yeppers Inc. is an amazing business model that connects online gaming with major brands. The model allows users to play casino games to win cash and prizes. The platform allows users to view their commercials, sample new products, and receive discounts. Users can play for free and earn points.","images":["/images/work/yeppers-gaming/img-1.jpg"],"videoUrl":null,"blocks":[{"type":"text-row","heading":"Approach","reverse":true,"text":"Fun, fun, fun, was the nucleus of our process when approaching the Yeppers brand. All that Yeppers presented had to look bigger, better, and more fun."},{"type":"full-image","image":"/images/work/yeppers-gaming/img-2.jpg","imageWidth":1600,"imageHeight":1067,"alt":"Yeppers Gaming platform UI"},{"type":"text-row","heading":"UI Design","text":"We wanted to create an upbeat experience for users when interacting with the platform. Bold shapes, complemented with pastels and bright colors, set the tone."},{"type":"text-row","heading":"Branding","reverse":true,"text":"The branding was based on the classic theme of board games made popular throughout the fifties and sixties. We designed it to be easily recognizable with a nostalgic feel."},{"type":"video-embed","variant":"ambient","src":"https://player.vimeo.com/video/720935380?api=1&background=1&autoplay=1&loop=1&title=0&byline=0&portrait=0"},{"type":"text-row","heading":"Video","text":"We expressed the same nostalgic feeling within the explanation video. The intention of the video was to guide potential users through the various applications in a fun and engaging way."}]}}],["$","$L16",null,{"project":"$a:0:props:project"}]]
