0:{"rsc":["$","$1","c",{"children":[[["$","$L2",null,{"project":{"slug":"dahle-printers","title":"Dahle Printing","category":null,"thumbnail":"/images/work/dahle-printers/thumb.jpg","summary":"The Dahle name is synonymous with quality and innovation on a global scale. Dahle products are engineered and developed in Germany. Dahle was founded in 1930 by Wilhelm Dahle. He first began producing steel cutting discs for pencil sharpeners. Throughout the years, Dahle’s product popularity and reputation for customer satisfaction have grown worldwide. Using the strictest standards for quality, they came to Speakerhead to illustrate the value and performance of their products.","images":["/images/work/dahle-printers/img-1.jpg"],"blocks":[{"type":"video-embed","variant":"ambient","src":"https://player.vimeo.com/video/720930684?api=1&background=1&autoplay=1&loop=1&title=0&byline=0&portrait=0"},{"type":"video-embed","variant":"ambient","src":"https://player.vimeo.com/video/720863700?api=1&background=1&autoplay=1&loop=1&title=0&byline=0&portrait=0"},{"type":"text-row","heading":"3D Modeling / Animation","text":"Dahle charged Speakerhead with the task of illustrating the durability and dynamic application of their top two industrial shredders. The animation was a straightforward depiction of the devices’ function and did not require a photorealistic approach. The importance was in simplifying the function visually to deliver clear and concise messaging. The final video was presented at trade shows and other industry events."}],"videoUrl":null}}],["$","$L3",null,{"project":"$0:rsc:props:children:0:0:props:project"}]],[["$","script","script-0",{"src":"/_next/static/chunks/1y7u-8e-s3dda.js","async":true}]],["$","$L4",null,{"children":["$","$5",null,{"name":"Next.MetadataOutlet","children":"$@6"}]}]]}],"isPartial":false,"staleTime":300,"varyParams":null,"buildId":"EuUkEz2n-gpKNLGZPLCbR"}
